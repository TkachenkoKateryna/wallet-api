# Copy to .env. The app, docker-compose and the migration/seed scripts all read this file.

# PostgreSQL connection (docker-compose also uses these to create the database)
DB_HOST=localhost
# Host port: 5432 (local install) and 5433 (my_postgres container) are taken
DB_PORT=5434
DB_USER=wallet
DB_PASSWORD=wallet
DB_NAME=wallet
DB_POOL_MAX=10

# Used by node-pg-migrate (npm run migrate:*) and database/seeds/seed.ts.
# Keep it in sync with the DB_* values above.
DATABASE_URL=postgresql://wallet:wallet@localhost:5434/wallet

# Lets database/seeds/seed.ts empty and reseed the database. Never set on shared databases.
ALLOW_DB_RESET=true
